Bootstrap: docker

# Use any docker image as a base (see https://hub.docker.com/)
# If using GPU, consider using a CUDA-enabled base image
From: python:3.11-slim

%labels
    Author FOMO25 Challenge - Classification Task
    Version v1.0.0
    Description FOMO25 Infarct Classification Apptainer Image

%environment
    export PYTHONUNBUFFERED=1
    export LC_ALL=C.UTF-8

%files
    # Copy your files (model, predict.py, requirements.txt, ...) to the container
    /media/jaume/DATA/Data/fomo25/fomo_apptainer_key /root/.ssh/id_ed25519
    ./requirements.txt /app/requirements.txt

%post
    # Create necessary directories
    mkdir -p /input /output /app
    
    # Update and install system dependencies
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        openssh-client \
        curl \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender1 \
        libgtk2.0-dev \
        libgl1 \
        && rm -rf /var/lib/apt/lists/*
    
    # Install Miniconda
    curl -fsSL https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -o miniconda.sh
    bash miniconda.sh -b -p /opt/conda
    rm miniconda.sh
    export PATH="/opt/conda/bin:$PATH"

    # Accept conda ToS
    /opt/conda/bin/conda config --set always_yes yes
    /opt/conda/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main
    /opt/conda/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r

    # Optional: Initialize conda shell (not strictly needed in non-interactive scripts)
    /opt/conda/bin/conda init bash

    # Set up SSH
    mkdir -p /root/.ssh
    chmod 600 /root/.ssh/id_ed25519
    ssh-keyscan github.com >> /root/.ssh/known_hosts

    # Clone the repo
    git clone git@github.com:jbanusco/3D-DINO.git /app/3D-DINO

    # Create conda env
    /opt/conda/bin/conda create -n dino3d python=3.9 -y

    # Install requirements directly into that env
    /opt/conda/envs/dino3d/bin/pip install --no-cache-dir -U pip setuptools wheel    
    /opt/conda/envs/dino3d/bin/pip install --no-cache-dir -r /app/requirements.txt
    /opt/conda/envs/dino3d/bin/pip install --no-cache-dir -r /app/3D-DINO/requirements.txt

    # Move dinov2 to the src level or install?
    mv /app/3D-DINO/dinov2 /app/

    # Symlink env python/pip to system paths (so `python` = conda env python)
    ln -sf /opt/conda/envs/dino3d/bin/python /usr/local/bin/python
    ln -sf /opt/conda/envs/dino3d/bin/pip /usr/local/bin/pip

%environment
    export PYTHONUNBUFFERED=1
    export LC_ALL=C.UTF-8
    export PATH="/opt/conda/envs/dino3d/bin:$PATH"
    export PYTHONPATH="/app/3D-DINO:$PYTHONPATH"

%runscript
    echo "Base image only — extend with app layer."